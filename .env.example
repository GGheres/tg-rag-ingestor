POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/tgrag?sslmode=disable
REDIS_ADDR=localhost:6379
QDRANT_URL=http://localhost:6333

APP_PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGIN=http://localhost:5173
MIGRATION_DIR=./migrations
EXPORT_DIR=./data/exports
DEFAULT_SYNC_BATCH_SIZE=100

# Go API -> Python audio service URL
PY_YOUTUBE_AUDIO_SERVICE_URL=http://localhost:8090

# Optional yt-dlp tuning
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
YTDLP_PLAYER_CLIENT=android
YTDLP_JS_RUNTIME=node
YTDLP_FETCH_METADATA=0
YTDLP_AUDIO_FORMAT=mp3
YTDLP_AUDIO_QUALITY=5
YOUTUBE_AUDIO_STORAGE_DIR=/srv/audio_storage

# Deepgram (pre-recorded transcription + diarization)
DEEPGRAM_API_KEY=
DEEPGRAM_API_KEY_FALLBACK=
DEEPGRAM_API_KEYS=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_DETECT_LANGUAGE=1
DEEPGRAM_SMART_FORMAT=1
DEEPGRAM_PUNCTUATE=1
DEEPGRAM_PARAGRAPHS=0
DEEPGRAM_CLIENT_TIMEOUT_SECONDS=900
DEEPGRAM_REQUEST_TIMEOUT_SECONDS=7200
DEEPGRAM_SDK_MAX_RETRIES=3
DEEPGRAM_ATTEMPTS_PER_KEY=3
DEEPGRAM_RETRY_BASE_SECONDS=2
DEEPGRAM_RETRY_MAX_SECONDS=30

TELEGRAM_MODE=stub
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+491234567890
TELEGRAM_PASSWORD=
TELEGRAM_AUTH_CODE=
TELEGRAM_SESSION_FILE=./data/tg.session.json

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-...
